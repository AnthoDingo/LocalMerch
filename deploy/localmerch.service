# Service utilisateur (la caisse a besoin de la session graphique).
# Installation : copier dans ~/.config/systemd/user/ puis
#   systemctl --user enable --now localmerch
[Unit]
Description=LocalMerch - caisse
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/localmerch/LocalMerch.App
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
